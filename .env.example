DATABASE_URL="postgresql://user:password@localhost:5432/nimble_quiz?schema=public"

# Nimiq network: this project runs on TESTNET.
NIMIQ_NETWORK="testnet"
# Base URL of your testnet node / indexer used for on-chain verification.
# No mainnet fallback: if unset, verification throws instead of checking the wrong chain.
NIMIQ_RPC_URL="https://your-testnet-node.example.com"

# Public explorer base shown in the UI (testnet).
NEXT_PUBLIC_NIMIQ_NETWORK="testnet"
NEXT_PUBLIC_NIMIQ_EXPLORER="https://testnet.nimiqscan.com/tx"

CRON_SECRET="your-secure-random-string-here"
